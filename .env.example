# HTMLRadar — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# Blank means "you must fill this in"; a value shown is a safe default.

# ============================================================
# 1. Core self-hosting — the web app (packages/app) and the proxy worker
# ============================================================
# Supabase project URL (Project Settings → API). Public by design.
SUPABASE_URL=
# Supabase anon key — the browser receives this; it is not a secret.
SUPABASE_ANON_KEY=
# Supabase service-role key — bypasses RLS. Server-side only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Database password — only needed if you apply schema/ with psql instead of the SQL editor.
SUPABASE_DB_PASSWORD=
# Same Supabase URL and anon key, exposed to the Next.js client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare API token used by the deploy workflow (Workers, R2, Pages, cache purge).
CLOUDFLARE_API_TOKEN=
# Cloudflare account id — the app derives the R2 endpoint from it when CLOUDFLARE_R2_ENDPOINT is blank.
CLOUDFLARE_ACCOUNT_ID=
# R2 bucket that holds uploaded HTML and attachments (must match packages/proxy/wrangler.toml).
CLOUDFLARE_R2_BUCKET=htmlradar-docs
# R2 API token pair with read+write on that bucket.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional explicit S3 endpoint: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
# HMAC key for the proxy's email/password gate cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Resend — first-read email notifications. Optional: without it the trigger logs a 'skipped' row.
RESEND_API_KEY=
# Sender shown on notification emails.
RESEND_FROM=HTMLRadar <hello@yourdomain.com>
# Comma-separated emails allowed to open /admin/events. Optional.
ADMIN_EMAILS=

# ============================================================
# 2. Optional billing — hosted Pro tier through Polar. Leave blank if you don't sell hosting.
# ============================================================
# Monthly checkout URL (the /upgrade page).
POLAR_CHECKOUT_URL=
# Annual checkout URL (the /upgrade page's yearly option).
POLAR_CHECKOUT_URL_ANNUAL=
# Polar product id of the annual plan — lets /settings offer a monthly-to-annual switch.
POLAR_PRODUCT_ID_ANNUAL=
# Legacy alias for POLAR_CHECKOUT_URL; any checkout URL works. POLAR_CHECKOUT_URL wins when both are set.
STRIPE_PAYMENT_LINK_URL=
# Verifies Polar webhook signatures (Polar organization settings).
POLAR_WEBHOOK_SECRET=
# Polar API key — the webhook resolves customers and /settings manages subscriptions with it.
POLAR_API_KEY=

# ============================================================
# 3. Monitor cron worker (packages/monitor) — deployed as Worker vars/secrets, listed here for reference
# ============================================================
# Address that receives regression alerts (a [vars] entry in packages/monitor/wrangler.toml).
ALERT_TO=
# PostHog ingest host for the app_events replay ([vars] entry).
POSTHOG_HOST=https://us.i.posthog.com
# PostHog project key (phc_...). Worker secret: `wrangler secret put POSTHOG_PROJECT_KEY`. Unset = replay is a no-op.
POSTHOG_PROJECT_KEY=
# Profile id of the QA smoke-test account, skipped during replay. Worker secret: `wrangler secret put QA_BOT_USER_ID`.
QA_BOT_USER_ID=
# Optional Telegram bot for the daily thread scan. Worker secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# 4. QA — Playwright smoke tests (packages/app/e2e) and local tracker replay fixtures
# ============================================================
# Base URL the smoke tests run against (default: https://htmlradar.com).
PLAYWRIGHT_BASE_URL=
# Sign-in for the QA account used by e2e/auth-setup.spec.ts.
QA_BOT_EMAIL=qa-bot@htmlradar.com
QA_BOT_PASSWORD=
# Slug and id of the share the smoke test opens and scrolls (default slug: qa-smoke-deck).
QA_TEST_SHARE_SLUG=
QA_TEST_SHARE_ID=
# Folder of local HTML fixtures for the tracker's replay tests; absent = those tests skip.
HR_FIXTURE_DIR=
# Base URL of a locally running proxy worker for ops/scripts/e2e-proxy.mjs.
PROXY_BASE=http://localhost:8787

# ============================================================
# 5. Publishing — search-engine notifications and the MCP server
# ============================================================
# IndexNow key. Public by protocol design (served at <your-domain>/<key>.txt); used by ops/scripts/gsc_index.py.
INDEXNOW_KEY=
# HTMLRadar API key (hr_live_...) for the MCP server (packages/mcp).
HTMLRADAR_API_KEY=
# Optional: API base URL for the MCP server when self-hosting (default: https://htmlradar.com).
HTMLRADAR_API_URL=
