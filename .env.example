# HTMLRadar — environment variables
# Copy to .env.local for local dev. Never commit .env.local.

# === Supabase (database + auth) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# === Next.js public env (web app) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Cloudflare (proxy worker, R2, Pages deploys) ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=htmlradar-docs
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Your bucket's S3 endpoint: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=

# === Resend (first-read email notifications, optional) ===
# Skip these if you don't need email notifications. The notify_on_first_open
# trigger writes a 'skipped' row to notifications_log and the rest of the
# product still works.
RESEND_API_KEY=
RESEND_FROM=HTMLRadar <hello@yourdomain.com>

# === Admin panel (optional) ===
# Comma-separated emails allowed to view /admin/events.
ADMIN_EMAILS=

# === Polar checkout + webhook (hosted Pro tier, optional) ===
# Leave all of these blank if you don't sell hosting.
# The checkout URL env is STRIPE_PAYMENT_LINK_URL for legacy reasons — it
# accepts any checkout URL (Polar, Stripe Payment Link, Lemon Squeezy, etc.);
# POLAR_CHECKOUT_URL is the canonical name and takes precedence when set.
POLAR_CHECKOUT_URL=
STRIPE_PAYMENT_LINK_URL=
# From your Polar organization settings — verifies webhook signatures and
# lets the webhook resolve customers.
POLAR_WEBHOOK_SECRET=
POLAR_API_KEY=

# === Email-gate session secret (HMAC for proxy gate cookies) ===
# Generate with: openssl rand -hex 32
SESSION_SECRET=
