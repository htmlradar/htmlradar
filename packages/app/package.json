{
  "name": "@htmlradar/app",
  "version": "0.1.0",
  "private": true,
  "description": "HTMLRadar web app — landing, auth, upload, share management, dashboard.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:edge": "next-on-pages --watch & wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat --port 3001",
    "build": "next build",
    "build:edge": "next-on-pages",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "qa:smoke": "playwright test e2e/smoke.spec.ts",
    "gen:og": "node scripts/generate-og-card.mjs",
    "gen:email-cards": "node scripts/generate-onboarding-cards.mjs",
    "gen:email-preview": "node scripts/render-onboarding-email.mjs",
    "gen:llms": "node scripts/gen-llms-full.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.42.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@playwright/test": "^1.43.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vercel": "^53.4.0",
    "vitest": "^1.4.0"
  }
}
