# HTMLRadar — environment variables
# Copy to .env.local for local dev. Never commit .env.local.

# === Supabase (database + auth) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# === Next.js public env (web app) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Cloudflare (proxy worker, R2, Pages deploys) ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=htmlradar-docs
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# === Resend (transactional email) ===
RESEND_API_KEY=
RESEND_FROM_ADDRESS=hello@htmlradar.com

# === Sentry (error tracking, free tier) ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# === Stripe (Payment Link only for v1.0, no integration) ===
STRIPE_PAYMENT_LINK_URL=

# === Tracker session secret (HMAC for session tokens) ===
SESSION_SECRET=
