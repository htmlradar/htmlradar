#!/usr/bin/env sh

# Identity assertion (docs/control/GIT-RULES.md rule 1: one identity, always).
if [ "$(git config user.email)" != "hello@htmlradar.com" ]; then
  echo "❌ Wrong git identity: commits must be authored hello@htmlradar.com (docs/control/GIT-RULES.md rule 1)."
  echo "   Fix it: git config user.email hello@htmlradar.com"
  exit 1
fi

# Run gitleaks if installed locally; the local scan is the first net and may not silently degrade.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v --config=.gitleaks.toml || {
    echo ""
    echo "❌ gitleaks found secrets in your staged changes. Commit blocked."
    echo "   Remove the secret, stage the cleaned file, and try again."
    exit 1
  }
else
  echo "❌ gitleaks not installed locally — the first-net secret scan cannot run. Commit blocked."
  echo "   Install it: brew install gitleaks"
  exit 1
fi

# Run lint-staged
npx lint-staged
